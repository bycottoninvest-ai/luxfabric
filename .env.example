# === Database ===
# Lokal va Vercel production: Postgres (Neon yoki Prisma Postgres).
# SQLite Vercel serverlessda ishlamaydi — mahsulotlar bo‘sh qoladi.
#
# Neon: https://console.neon.tech → Project → Connection string (URI)
# Misol (o‘zingiznikini qo‘ying):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="LUXFABRIC"
NEXT_PUBLIC_PROD_DOMAIN="https://luxfabricshop.uz"

# Admin panel kirish (/admin/login)
# Vercel → Settings → Environment Variables ga ham qo‘ying
ADMIN_PASSWORD="kuchli-parolingiz"
# Cookie imzo (ixtiyoriy, lekin productionda tavsiya)
ADMIN_SESSION_SECRET="uzun-tasodifiy-matn"

# Direktor Telegram (har bir zakaz xabari)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DIRECTOR_CHAT_ID=""

# ChatGPT — Reel AI matn + Instagram izoh/DM + sharh javoblari
# Kalit: https://platform.openai.com/api-keys
# Yo‘q bo‘lsa — shablon javob ishlaydi. Qo‘shgach: npm run dev / Vercel redeploy
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Vercel Blob (video/musiqa/rasm) — create-store avtomatik qo‘yadi
# BLOB_READ_WRITE_TOKEN=""

# Instagram / Meta Graph (yoki admin → Instagram → Meta/DM panel orqali)
# Page token + public HTTPS domen (localhost Meta media o‘qimaydi)
INSTAGRAM_PAGE_TOKEN=""
INSTAGRAM_IG_USER_ID=""
INSTAGRAM_VERIFY_TOKEN="luxfabric_verify"

# Click.uz SHOP API (merchant.click.uz)
# Secret ni Vercel Env ga qo‘ying — commit qilmang.
# Admin → Sozlamalar orqali ham (click_merchant_id / service_id / secret) mumkin.
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
# Callback (Click kabinet):
# Prepare:  https://www.luxfabricshop.uz/api/click/prepare
# Complete: https://www.luxfabricshop.uz/api/click/complete
# Yoki bitta: https://www.luxfabricshop.uz/api/click
