generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production: Neon / Prisma Postgres. Lokal: xuddi shu Postgres URL (SQLite Vercelda ishlamaydi).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  fabric      String
  care        String
  gender      String           @default("WOMEN")
  price       Int
  oldPrice    Int?
  rating      Float            @default(4.8)
  soldCount   Int              @default(0)
  status      String           @default("ACTIVE")
  featured    Boolean          @default(false)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  reels       InstagramReel[]
  stories     InstagramStory[]
  reviews              Review[]
  /// Meta Commerce catalog product id (Instagram Shopping). Needs Facebook Login + Shop approval.
  metaCatalogProductId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  color     String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String           @id @default(cuid())
  sku        String           @unique
  color      String
  colorHex   String
  size       String
  barcode    String           @unique
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks     WarehouseStock[]
  orderItems OrderItem[]
  scans      ScanEvent[]
}

model Region {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  nameUz     String
  sortOrder  Int         @default(0)
  warehouses Warehouse[]
}

model Warehouse {
  id        String           @id @default(cuid())
  name      String
  city      String
  address   String
  phone     String?
  lat       Float
  lng       Float
  isCentral Boolean          @default(false)
  isActive  Boolean          @default(true)
  regionId  String?
  region    Region?          @relation(fields: [regionId], references: [id])
  stocks    WarehouseStock[]
  orders    Order[]
  scans     ScanEvent[]
}

model WarehouseStock {
  id          String         @id @default(cuid())
  quantity    Int            @default(0)
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  city      String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model CourierPartner {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  nameUz           String
  phone            String?
  website          String?
  apiBaseUrl       String?
  isActive         Boolean  @default(true)
  supportsCod      Boolean  @default(true)
  coverage         String   @default("UZ")
  sortOrder        Int      @default(0)
  notes            String?
  assignedOrders   Order[]  @relation("AssignedCourier")
  preferredOrders  Order[]  @relation("PreferredCourier")
  createdAt        DateTime @default(now())
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  status            String          @default("NEW")
  paymentMethod     String
  paymentStatus     String          @default("PENDING")
  subtotal          Int
  deliveryFee       Int             @default(0)
  total             Int
  customerName      String
  customerPhone     String
  city              String
  address           String
  note              String?
  source            String          @default("STORE")
  deliveryType      String          @default("SHOP_DELIVERY")
  /// Viloyat kodi (TAS, XOR, …) — promise / carrier matrix
  regionCode        String?
  /// HOME | PVZ | WAREHOUSE
  handoffMode       String?
  /// Mijozga va’da qilingan yetkazish sanasi (kun oxiri, Toshkent)
  promisedBy        DateTime?
  /// Ombor jo‘natish deadline (cutoff 15:00)
  shipBy            DateTime?
  /// Checkoutdagi va’da matni (snapshot)
  promiseLabel      String?
  notifyChannel     String          @default("SMS")
  telegramUsername  String?
  preferredCourierId String?
  preferredCourier  CourierPartner? @relation("PreferredCourier", fields: [preferredCourierId], references: [id])
  /// Mijoz tanlagan kompaniya kodi (BTS, FARGO, …) — UI katalogi bilan mos
  courierCompanyId  String?
  /// Tanlangan filial/punkt id (uz-couriers branches)
  courierBranchId   String?
  /// Filial manzili matni (snapshot)
  courierBranchLabel String?
  courierCode       String?
  courierTracking   String?
  courierLabel      String?
  handedToCourierAt DateTime?
  stockDeducted     Boolean         @default(true)
  cardSavedAt       DateTime?
  /// Click SHOP API: merchant_prepare_id / click_trans_id
  clickTransId      String?
  clickPrepareId    Int?
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  courierId         String?
  courier           CourierPartner? @relation("AssignedCourier", fields: [courierId], references: [id])
  items             OrderItem[]
  events            TrackingEvent[]
  scans             ScanEvent[]
  reviews           Review[]
  /// Checkout qurilmasiga berilgan tokenning SHA-256 heshi (plaintext saqlanmaydi)
  deviceTokenHash   String?
  /// Admin Telegram xabari (editMessage / inline status)
  telegramMessageId String?
  telegramChatId    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([shipBy, status])
  @@index([regionCode])
  @@index([customerPhone])
}

/// Mahsulot sharhi (Wildberries-lite): yulduz + matn + foto
model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating       Int
  text         String   @default("")
  photoUrls    String[] @default([])
  customerName String
  customerPhone String?
  /// PENDING | APPROVED | REJECTED
  status       String   @default("PENDING")
  /// Do‘kon AI / admin javobi
  shopReply    String?
  shopRepliedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, status])
  @@index([status, createdAt])
}

/// Instagram izohga bir marta javob berilganini kuzatish (spam oldini olish)
model InstagramCommentReply {
  id          String   @id @default(cuid())
  commentId   String   @unique
  mediaId     String?
  commentText String   @default("")
  replyText   String
  source      String   @default("ai") // ai | template
  createdAt   DateTime @default(now())
}

/// Instagram Reel izohlari (webhook + Graph sync) — admin panelda ko‘rish
model InstagramComment {
  id           String         @id @default(cuid())
  commentId    String         @unique
  mediaId      String?
  reelId       String?
  reel         InstagramReel? @relation(fields: [reelId], references: [id], onDelete: SetNull)
  username     String         @default("")
  fromId       String?
  text         String
  parentId     String?
  postedAt     DateTime?
  ourReplyText String?
  ourReplyId   String?
  repliedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([mediaId])
  @@index([reelId, postedAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  quantity  Int
  pickedQty Int            @default(0)
  price     Int
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  status    String
  title     String
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model InstagramMusic {
  id          String          @id @default(cuid())
  title       String
  artist      String          @default("LUXFABRIC")
  fileUrl     String
  durationSec Int?
  createdAt   DateTime        @default(now())
  reels       InstagramReel[]
}

model InstagramReel {
  id             String          @id @default(cuid())
  title          String
  caption        String          @default("")
  videoUrl       String
  coverUrl       String?
  buyButtonLabel String          @default("Sotib olish")
  showBuyButton  Boolean         @default(true)
  isPublished    Boolean         @default(true)
  sortOrder      Int             @default(0)
  views          Int             @default(0)
  /// Video fayliga musiqa biriktirilgan (ffmpeg mux) — alohida audio kerak emas
  audioEmbedded  Boolean         @default(false)
  metaMediaId    String?
  metaPublishedAt DateTime?
  musicId        String?
  music          InstagramMusic? @relation(fields: [musicId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  comments       InstagramComment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// Instagram Story (hikoya) — rasm/video + mahsulot havolasi
model InstagramStory {
  id         String    @id @default(cuid())
  title      String
  caption    String    @default("")
  mediaUrl   String
  mediaType  String    @default("image") // image | video
  linkLabel  String    @default("Sotib olish")
  isPublished Boolean  @default(true)
  sortOrder  Int       @default(0)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  metaMediaId String?
  metaPublishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// QR skaner jurnali — kirim/chiqim/buyurtma yigish
model ScanEvent {
  id          String           @id @default(cuid())
  action      String
  rawCode     String
  quantity    Int              @default(1)
  note        String?
  barcode     String?
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id])
  variantId   String?
  variant     ProductVariant?  @relation(fields: [variantId], references: [id])
  warehouseId String?
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime         @default(now())
}
